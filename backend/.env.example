ENV=dev
DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/memory
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_SNAPSHOTS=snapshots
MINIO_SECURE=false
SERVICE_SIGNING_KEY_PATH=./keys/service.ed25519

# LLM provider — one of:
#   openai, deepseek, minimax, moonshot, kimi, zhipu, glm, qwen, dashscope,
#   openai_compatible (any other), anthropic, claude
LLM_PROVIDER=openai_compatible
# Override base_url. Empty = use the default for the provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

JWT_SECRET=change-me-in-prod
JWT_TTL_DAYS=7
# Empty disables hCaptcha verification (suitable for local dev only).
HCAPTCHA_SECRET=

# Followup web search.
# Empty = followup disabled. "stub" = no-op for dev. "minimax" = MiniMax
# web search (wire-format pending).
SEARCH_PROVIDER=
SEARCH_BASE_URL=
SEARCH_API_KEY=
SEARCH_TIMEOUT=30

# Comma-separated list of origins allowed by CORS, e.g.
#   https://memory.example.com,https://www.memory.example.com
# Empty disables CORS (single-origin / reverse-proxy setups).
CORS_ORIGINS=

# Optional Nostr bridge (cold-start seed for the decentralized extension).
# Run: python -m app.bridge.run --limit 100
# Empty NOSTR_BRIDGE_SECKEY disables it. Generate a 32-byte secp256k1 key, hex.
NOSTR_BRIDGE_SECKEY=
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
