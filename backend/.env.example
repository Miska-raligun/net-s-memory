ENV=dev
DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/memory
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_SNAPSHOTS=snapshots
MINIO_SECURE=false
SERVICE_SIGNING_KEY_PATH=./keys/service.ed25519

# LLM provider — one of:
#   openai, deepseek, minimax, moonshot, kimi, zhipu, glm, qwen, dashscope,
#   openai_compatible (any other), anthropic, claude
LLM_PROVIDER=openai_compatible
# Override base_url. Empty = use the default for the provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

JWT_SECRET=change-me-in-prod
JWT_TTL_DAYS=7
# Empty disables hCaptcha verification (suitable for local dev only).
HCAPTCHA_SECRET=
