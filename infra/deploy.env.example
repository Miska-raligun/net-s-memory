# ---- Postgres / MinIO credentials ----
POSTGRES_USER=memory
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=memory
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_me

# ---- JWT (server-side session signing) ----
JWT_SECRET=replace_me
JWT_TTL_DAYS=7

# ---- Ports exposed to the host ----
WEB_PORT=3000
API_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Browser-facing API URL (BAKED INTO web bundle at build time) ----
# Local trial: http://localhost:8000
# Public:     https://memory.example.com  (use a reverse proxy)
PUBLIC_API_BASE=http://localhost:8000

# Origins allowed to call the API directly. Comma-separated. Empty = same-origin.
# Example: http://localhost:3000,https://memory.example.com
CORS_ORIGINS=http://localhost:3000

# ---- Optional: LLM provider (analysis + followup require this) ----
# Provider: openai / deepseek / minimax / moonshot / kimi / zhipu / glm /
#           qwen / dashscope / openai_compatible / anthropic / claude
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Optional: web search for followup tracker ----
# Provider: minimax / stub
SEARCH_PROVIDER=
SEARCH_BASE_URL=
SEARCH_API_KEY=

# ---- Optional: hCaptcha for signup ----
HCAPTCHA_SECRET=
